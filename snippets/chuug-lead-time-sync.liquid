{%- comment -%}
  CHUUG Lead Time Sync Snippet
  Auto-syncs shop.metafields.chuug._days to a cart attribute.
  Updated by update-lead-time.js on 2026-05-01T15:17:23.627Z
{%- endcomment -%}

{%- assign _days = shop.metafields.chuug._days | plus: 0 -%}
{%- if _days == 0 -%}
  {%- assign _days = 5 -%}
{%- endif -%}

<script>
(function() {
  var LEAD_DAYS = {{ _days }};
  var STORAGE_KEY = 'chuug_lead_days';
  try {
    var cached = localStorage.getItem(STORAGE_KEY);
    if (cached === String(LEAD_DAYS)) return;
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        attributes: {
          '__days': String(LEAD_DAYS),
          '_chuug_lead_time': String(LEAD_DAYS)
        }
      })
    }).then(function(r) {
      if (r.ok) {
        localStorage.setItem(STORAGE_KEY, String(LEAD_DAYS));
      }
    }).catch(function() {});
  } catch(e) {}
})();
</script>